# ──────────────────────────────────────────────────────────────────────
# CALQULUS PMS — environment variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development.
# For Vercel production deployments, set the `VITE_*` values below in the
# Vercel project settings (Settings → Environment Variables) so that
# `vercel pull` / `vercel build` pick them up. Without VITE_SUPABASE_URL
# and VITE_SUPABASE_PUBLISHABLE_KEY the app boots in a non-functional
# "preview mode" (see src/integrations/supabase/client.ts).

# ── Supabase (REQUIRED for a working backend) ─────────────────────────
# Find these in your Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── Optional: error monitoring ───────────────────────────────────────
# VITE_SENTRY_DSN=""           # Sentry project DSN
# VITE_SENTRY_ENV="production" # environment tag sent to Sentry

# ── Optional: app behaviour tuning ───────────────────────────────────
# VITE_APP_VERSION=""          # override the build-derived version string
# VITE_AUTH_TIMEOUT_MS="8000"  # auth session load timeout (ms)

# ── Demo / staging feature flags (keep false in production) ──────────
VITE_ENABLE_PUBLIC_DEMO="false"
VITE_ENABLE_DEMO_SEED="false"
VITE_DEMO_SEED_SECRET=""

# ── No-login dev access ───────────────────────────────────────────────
# When true, the app auto-signs into the default dev account on boot and
# lifts login/approval/role guards so every portal is reachable without
# Production builds never enable this, even if set to true.
VITE_ENABLE_DEV_ACCESS="false"
# Optional generic auto-login override. Do not commit real credentials.
# VITE_DEV_ACCESS_EMAIL=""
# VITE_DEV_ACCESS_PASSWORD=""
# Optional portal presets for the development switcher. Each account is
# shown only when BOTH its email and password are configured locally.
# VITE_DEV_MANAGER_EMAIL=""
# VITE_DEV_MANAGER_PASSWORD=""
# VITE_DEV_WEBHOST_EMAIL=""
# VITE_DEV_WEBHOST_PASSWORD=""
# VITE_DEV_TENANT_EMAIL=""
# VITE_DEV_TENANT_PASSWORD=""
# VITE_DEV_AGENCY_EMAIL=""
# VITE_DEV_AGENCY_PASSWORD=""
# VITE_DEV_LANDLORD_EMAIL=""
# VITE_DEV_LANDLORD_PASSWORD=""

# ── Webhooks & Monitoring Alert Integrations ──────────────────────────
# VITE_WEBHOOK_PAYMENT_FAILURES=""
# VITE_WEBHOOK_SECURITY_ALERTS=""
# VITE_WEBHOOK_CALLBACK_FAILURES=""
# VITE_WEBHOOK_DATABASE_ANOMALIES=""
# VITE_WEBHOOK_SECRET=""

# ── Playwright E2E (optional; GitHub Actions secrets, not Vercel) ─────
# E2E_MANAGER_EMAIL=""
# E2E_MANAGER_PASSWORD=""
# E2E_TENANT_EMAIL=""
# E2E_TENANT_PASSWORD=""
# E2E_LANDLORD_EMAIL=""
# E2E_LANDLORD_PASSWORD=""
# E2E_AGENCY_EMAIL=""
# E2E_AGENCY_PASSWORD=""
# E2E_WEBHOST_EMAIL=""
# E2E_WEBHOST_PASSWORD=""
# E2E_SUPABASE_URL=""
# E2E_SUPABASE_PUBLISHABLE_KEY=""



